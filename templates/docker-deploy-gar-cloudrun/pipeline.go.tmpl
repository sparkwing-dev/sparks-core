// Scaffolded from the docker-deploy-gar-cloudrun template. Edit freely --
// nothing here re-runs.
package jobs

import (
	"context"
	"fmt"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/sparkwing-dev/sparkwing/sparkwing"

	"github.com/sparkwing-dev/sparks-core/cloudrun"
	"github.com/sparkwing-dev/sparks-core/gcp"
	"github.com/sparkwing-dev/sparks-core/probe"
)

// {{pascal .pipeline_name}} builds {{.image}}, pushes it to {{.registry}},
// and deploys it to the Cloud Run service {{.service}}, shifting traffic
// back on a definitively-unhealthy probe.
type {{pascal .pipeline_name}} struct {
	sparkwing.Base
	// tag is computed once in build and reused so all three nodes name the
	// same image. No lock is needed: the Needs edges order them.
	tag string
	// url is empty under SPARKWING_DRY_RUN, which skips the probe.
	url string
	// priorRevision lets rollback target the previously serving revision
	// precisely rather than rediscovering a best-effort prior.
	priorRevision string
}

func (p *{{pascal .pipeline_name}}) Plan(_ context.Context, plan *sparkwing.Plan, _ sparkwing.NoInputs, _ sparkwing.RunContext) error {
{{if .test_cmd}}	test := sparkwing.Job(plan, "test", func(ctx context.Context) error {
		_, err := sparkwing.Bash(ctx, {{quote .test_cmd}}).Run()
		return err
	})
	build := sparkwing.Job(plan, "build", p.build).Needs(test)
{{else}}	build := sparkwing.Job(plan, "build", p.build)
{{end}}	push := sparkwing.Job(plan, "push", p.push).
		Needs(build).
		Retry(3, sparkwing.RetryBackoff(3*time.Second)).
		Timeout(10 * time.Minute)
	sparkwing.Job(plan, "deploy", p.deploy).
		Needs(push).
		Verify(p.verify).
		OnFailure("rollback", p.rollback)
	return nil
}

// build runs for real even under SPARKWING_DRY_RUN so a broken Dockerfile
// still fails the pipeline; only the registry and Cloud Run mutations echo.
func (p *{{pascal .pipeline_name}}) build(ctx context.Context) error {
	p.tag = time.Now().UTC().Format("20060102-150405")
	_, err := sparkwing.Exec(ctx, "docker", "build",
		"-t", {{quote .image}}+":"+p.tag,
		"-f", {{quote .dockerfile}}, {{quote .build_context}}).Run()
	return err
}

func (p *{{pascal .pipeline_name}}) push(ctx context.Context) error {
	if err := gcp.ConfigureDockerAuth(ctx, garHost({{quote .registry}})); err != nil {
		return err
	}
	local := {{quote .image}} + ":" + p.tag
	remote := {{quote .registry}} + "/" + {{quote .image}} + ":" + p.tag
	if _, err := sparkwing.Exec(ctx, "docker", "tag", local, remote).Run(); err != nil {
		return err
	}
	if os.Getenv("SPARKWING_DRY_RUN") != "" {
		sparkwing.Info(ctx, "DRY RUN: docker push %s", remote)
		return nil
	}
	_, err := sparkwing.Exec(ctx, "docker", "push", remote).Run()
	return err
}

func (p *{{pascal .pipeline_name}}) deploy(ctx context.Context) error {
	port := 0
	if raw := {{quote .port}}; raw != "" {
		parsed, err := strconv.Atoi(raw)
		if err != nil {
			return fmt.Errorf("invalid port %q: %w", raw, err)
		}
		port = parsed
	}
	res, err := cloudrun.Deploy(ctx, cloudrun.DeployConfig{
		Service:              {{quote .service}},
		Image:                {{quote .registry}} + "/" + {{quote .image}} + ":" + p.tag,
		Region:               {{quote .region}},
		Project:              {{quote .project}},
		Port:                 port,
		Env:                  parseEnv({{quote .env}}),
		AllowUnauthenticated: truthy({{quote .allow_unauthenticated}}),
		ExtraArgs:            setSecretsArgs({{quote .secrets}}),
	})
	if err != nil {
		return err
	}
	p.url = res.URL
	p.priorRevision = res.PriorRevision
	return nil
}

// verify passes when the deploy returned no URL, since nothing is live to probe.
func (p *{{pascal .pipeline_name}}) verify(ctx context.Context) error {
	if p.url == "" {
		sparkwing.Info(ctx, "no service URL resolved (dry-run) - skipping health probe")
		return nil
	}
	return probe.HTTP(p.url + {{quote .health_path}}).Retry(30).Interval(2 * time.Second).Check(ctx)
}

// rollback shifts traffic only on a definitive failure: an indeterminate
// probe is no evidence the new revision is bad, so reverting on it would
// move production off a possibly-healthy deploy.
func (p *{{pascal .pipeline_name}}) rollback(ctx context.Context, f sparkwing.Failure) error {
	if f.Stage == sparkwing.StageVerify && probe.Indeterminate(f.Err) {
		sparkwing.Warn(ctx, "post-deploy health check could not determine health (%v) - leaving the new revision in place; investigate", f.Err)
		return f.Err
	}
	sparkwing.Warn(ctx, "deploy failed at %s stage - shifting traffic back to the prior revision", f.Stage)
	return cloudrun.Rollback(cloudrun.RollbackConfig{
		Service:  {{quote .service}},
		Region:   {{quote .region}},
		Project:  {{quote .project}},
		Revision: p.priorRevision,
	})(ctx)
}

// garHost drops the path, which is what `gcloud auth configure-docker` expects.
func garHost(registry string) string {
	if i := strings.IndexByte(registry, '/'); i >= 0 {
		return registry[:i]
	}
	return registry
}

func parseEnv(raw string) map[string]string {
	if raw == "" {
		return nil
	}
	env := map[string]string{}
	for _, pair := range strings.Split(raw, ",") {
		k, v, ok := strings.Cut(pair, "=")
		if !ok {
			continue
		}
		env[strings.TrimSpace(k)] = v
	}
	return env
}

// setSecretsArgs adds no flag for an empty parameter, leaving the service's
// existing secrets untouched.
func setSecretsArgs(raw string) []string {
	if raw == "" {
		return nil
	}
	return []string{"--set-secrets", raw}
}

// truthy treats "", "false", "0", "no", and "off" as false, so a stray
// allow-unauthenticated=false yields a private service, not a public one.
func truthy(s string) bool {
	switch strings.ToLower(strings.TrimSpace(s)) {
	case "", "false", "0", "no", "off":
		return false
	default:
		return true
	}
}

func init() {
	sparkwing.Register[sparkwing.NoInputs]({{quote .pipeline_name}}, func() sparkwing.Pipeline[sparkwing.NoInputs] {
		return &{{pascal .pipeline_name}}{}
	})
}
