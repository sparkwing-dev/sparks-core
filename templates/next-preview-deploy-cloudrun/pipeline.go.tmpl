// Scaffolded from the next-preview-deploy-cloudrun template. Edit freely --
// nothing here re-runs.
package jobs

import (
	"context"
	"fmt"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/sparkwing-dev/sparkwing/sparkwing"

	"github.com/sparkwing-dev/sparks-core/cloudrun"
	"github.com/sparkwing-dev/sparks-core/gcp"
	"github.com/sparkwing-dev/sparks-core/probe"
)

// {{pascal .pipeline_name}} builds {{.image}} and deploys it as a tagged
// no-traffic preview revision of {{.service}}, printing the stable
// per-branch preview URL a health probe checks.
type {{pascal .pipeline_name}} struct {
	sparkwing.Base
	// slug is computed once in Plan so the preview URL's tag is stable
	// across deploys of a branch.
	slug string
	// imageTag is computed once in build and reused so all three nodes name
	// the same image, and folds in a timestamp so each push of a branch
	// yields a new preview revision. No lock is needed: the Needs edges
	// order the nodes.
	imageTag string
	// url is empty under SPARKWING_DRY_RUN, which skips the probe.
	url string
}

func (p *{{pascal .pipeline_name}}) Plan(_ context.Context, plan *sparkwing.Plan, _ sparkwing.NoInputs, rc sparkwing.RunContext) error {
	branch := {{quote .branch_ref}}
	if branch == "" && rc.Git != nil {
		branch = rc.Git.Branch
	}
	p.slug = previewSlug(branch)
{{if .test_cmd}}	test := sparkwing.Job(plan, "test", func(ctx context.Context) error {
		_, err := sparkwing.Bash(ctx, {{quote .test_cmd}}).Run()
		return err
	})
	build := sparkwing.Job(plan, "build", p.build).Needs(test)
{{else}}	build := sparkwing.Job(plan, "build", p.build)
{{end}}	push := sparkwing.Job(plan, "push", p.push).Needs(build)
	sparkwing.Job(plan, "deploy", p.deploy).
		Needs(push).
		Verify(p.verify)
	return nil
}

// build runs for real even under SPARKWING_DRY_RUN so a broken Dockerfile
// still fails the pipeline; only the registry and Cloud Run mutations echo.
func (p *{{pascal .pipeline_name}}) build(ctx context.Context) error {
	p.imageTag = p.slug + "-" + time.Now().UTC().Format("20060102-150405")
	_, err := sparkwing.Exec(ctx, "docker", "build",
		"-t", {{quote .image}}+":"+p.imageTag,
		"-f", {{quote .dockerfile}}, {{quote .build_context}}).Run()
	return err
}

func (p *{{pascal .pipeline_name}}) push(ctx context.Context) error {
	if err := gcp.ConfigureDockerAuth(ctx, garHost({{quote .registry}})); err != nil {
		return err
	}
	local := {{quote .image}} + ":" + p.imageTag
	remote := {{quote .registry}} + "/" + {{quote .image}} + ":" + p.imageTag
	if _, err := sparkwing.Exec(ctx, "docker", "tag", local, remote).Run(); err != nil {
		return err
	}
	if os.Getenv("SPARKWING_DRY_RUN") != "" {
		sparkwing.Info(ctx, "DRY RUN: docker push %s", remote)
		return nil
	}
	_, err := sparkwing.Exec(ctx, "docker", "push", remote).Run()
	return err
}

// deploy leaves the revision reachable at its own tagged URL while serving
// no production traffic, so deploying a branch never affects the live service.
func (p *{{pascal .pipeline_name}}) deploy(ctx context.Context) error {
	port := 0
	if raw := {{quote .port}}; raw != "" {
		parsed, err := strconv.Atoi(raw)
		if err != nil {
			return fmt.Errorf("invalid port %q: %w", raw, err)
		}
		port = parsed
	}
	res, err := cloudrun.Deploy(ctx, cloudrun.DeployConfig{
		Service:              {{quote .service}},
		Image:                {{quote .registry}} + "/" + {{quote .image}} + ":" + p.imageTag,
		Region:               {{quote .region}},
		Project:              {{quote .project}},
		Port:                 port,
		Env:                  parseEnv({{quote .env}}),
		Tag:                  p.slug,
		NoTraffic:            true,
		AllowUnauthenticated: truthy({{quote .allow_unauthenticated}}),
	})
	if err != nil {
		return err
	}
	p.url = res.URL
	if p.url == "" {
		sparkwing.Info(ctx, "preview revision tagged %q deployed (no URL resolved under dry-run)", p.slug)
		return nil
	}
	sparkwing.Info(ctx, "preview for %q is live at %s", p.slug, p.url)
	return nil
}

// verify passes when the deploy returned no URL, since nothing is live to probe.
func (p *{{pascal .pipeline_name}}) verify(ctx context.Context) error {
	if p.url == "" {
		sparkwing.Info(ctx, "no preview URL resolved (dry-run) - skipping health probe")
		return nil
	}
	return probe.HTTP(p.url + {{quote .health_path}}).Retry(30).Interval(2 * time.Second).Check(ctx)
}

// previewSlug makes a ref DNS-safe for a Cloud Run revision tag; an empty
// ref yields "preview".
func previewSlug(ref string) string {
	var b strings.Builder
	prevHyphen := false
	for _, r := range strings.ToLower(ref) {
		switch {
		case r >= 'a' && r <= 'z', r >= '0' && r <= '9':
			b.WriteRune(r)
			prevHyphen = false
		default:
			if b.Len() > 0 && !prevHyphen {
				b.WriteByte('-')
				prevHyphen = true
			}
		}
	}
	slug := strings.Trim(b.String(), "-")
	if slug == "" {
		return "preview"
	}
	if slug[0] >= '0' && slug[0] <= '9' {
		slug = "p-" + slug
	}
	const maxLen = 40
	if len(slug) > maxLen {
		slug = strings.Trim(slug[:maxLen], "-")
	}
	return slug
}

// garHost drops the path, which is what `gcloud auth configure-docker` expects.
func garHost(registry string) string {
	if i := strings.IndexByte(registry, '/'); i >= 0 {
		return registry[:i]
	}
	return registry
}

// parseEnv values reach --set-env-vars; keep credentials out, in sparkwing
// secrets.
func parseEnv(raw string) map[string]string {
	if raw == "" {
		return nil
	}
	env := map[string]string{}
	for _, pair := range strings.Split(raw, ",") {
		k, v, ok := strings.Cut(pair, "=")
		if !ok {
			continue
		}
		env[strings.TrimSpace(k)] = v
	}
	return env
}

// truthy treats "", "false", "0", "no", and "off" as false, so a stray
// allow-unauthenticated=false yields a private preview, not a public one.
func truthy(s string) bool {
	switch strings.ToLower(strings.TrimSpace(s)) {
	case "", "false", "0", "no", "off":
		return false
	default:
		return true
	}
}

func init() {
	sparkwing.Register[sparkwing.NoInputs]({{quote .pipeline_name}}, func() sparkwing.Pipeline[sparkwing.NoInputs] {
		return &{{pascal .pipeline_name}}{}
	})
}
