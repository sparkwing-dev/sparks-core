const (
	mainPkg      = {{quote .main_package}}
	binaryName   = {{quote .binary_name}}
	releaseDir   = {{quote .release_dir}}
	platformList = {{quote .platforms}}
	versionVar   = {{quote .version_var}}
	tokenSecret  = {{quote .token_secret}}
	slackSecret  = {{quote .slack_webhook_secret}}
)

// publishDryRun is true only for the literal `true`; any other value
// publishes. SPARKWING_DRY_RUN forces echo-and-skip regardless.
const publishDryRun = {{if eq .dry_run "true"}}true{{else}}false{{end}}

// {{pascal .pipeline_name}} cross-compiles {{.main_package}}, checksums the
// artifacts, and cuts a GitHub Release with them and the notes attached.
type {{pascal .pipeline_name}} struct{ sparkwing.Base }

func ({{pascal .pipeline_name}}) ShortHelp() string {
	return "Cross-build {{.binary_name}}, checksum, and cut a GitHub Release"
}

func (p *{{pascal .pipeline_name}}) Plan(_ context.Context, plan *sparkwing.Plan, _ sparkwing.NoInputs, _ sparkwing.RunContext) error {
	build := sparkwing.Job(plan, "cross-build", {{pascal .pipeline_name}}Action(p.build))
	checksum := sparkwing.Job(plan, "checksum", {{pascal .pipeline_name}}Action(p.checksum)).Needs(build)
	sparkwing.Job(plan, "github-release", {{pascal .pipeline_name}}Action(p.release)).Needs(checksum)
	return nil
}

func (p *{{pascal .pipeline_name}}) versionNotes(ctx context.Context) (string, string, error) {
{{- if eq .notes_source "git" }}
	version, err := release.DeriveVersion(ctx, release.VersionConfig{
		Version:        {{quote .version}},
		Describe:       true,
		Match:          "v*",
		RefuseDirty:    {{if eq .refuse_dirty "true"}}true{{else}}false{{end}},
		AllowNonSemver: true,
	})
	if err != nil {
		return "", "", err
	}
	notes, err := gitLogNotes(ctx)
	if err != nil {
		return "", "", err
	}
{{- else }}
	notes, version, err := release.ChangelogEntry(ctx, release.NotesConfig{
		Path:    {{quote .changelog_path}},
		Version: {{quote .version}},
	})
	if err != nil {
		return "", "", err
	}
{{- end }}
	return version, notes, nil
}

func (p *{{pascal .pipeline_name}}) build(ctx context.Context) error {
	version, _, err := p.versionNotes(ctx)
	if err != nil {
		return err
	}

	artifacts, err := release.CrossBuildGo(ctx, release.CrossBuildConfig{
		MainPkg:    mainPkg,
		BinaryName: binaryName,
		Version:    version,
		Platforms:  platforms(),
		OutDir:     releaseDir,
		LDFlags:    fmt.Sprintf("-X %s=%s", versionVar, version),
		Trimpath:   true,
	})
	if err != nil {
		return err
	}
	sparkwing.Annotate(ctx, sparkwing.Annotation{Message: fmt.Sprintf("built %d artifacts for %s", len(artifacts), version)})
	return nil
}

func (p *{{pascal .pipeline_name}}) checksum(ctx context.Context) error {
	return release.Checksums(ctx, release.ChecksumConfig{Dir: releaseDir})
}

// release posts an optional Slack announce after a live publish; an unset
// slack-webhook-secret skips it.
func (p *{{pascal .pipeline_name}}) release(ctx context.Context) error {
	version, notes, err := p.versionNotes(ctx)
	if err != nil {
		return err
	}
	// Jobs run in separate processes, so derive the same paths from the inputs.
	assets := []string{filepath.Join(releaseDir, "checksums.txt")}
	for _, platform := range platforms() {
		goos, goarch, _ := strings.Cut(platform, "/")
		assets = append(assets, release.ArtifactPath(releaseDir, binaryName, version, goos, goarch))
	}
	if err := release.GitHubRelease(ctx, release.GitHubReleaseConfig{
		Tag:         version,
		Notes:       notes,
		Assets:      assets,
		Draft:       {{if eq .draft "true"}}true{{else}}false{{end}},
		Prerelease:  {{if eq .prerelease "true"}}true{{else}}false{{end}},
		TokenSecret: tokenSecret,
		DryRun:      publishDryRun,
	}); err != nil {
		return err
	}
	if publishDryRun || dryRun() || slackSecret == "" {
		return nil
	}
	hook, err := sparkwing.Secret(ctx, slackSecret)
	if err != nil {
		return err
	}
	return notify.Slack(ctx, hook, fmt.Sprintf("released %s %s", binaryName, version))
}

func platforms() []string {
	var out []string
	for _, p := range strings.Split(platformList, ",") {
		if p = strings.TrimSpace(p); p != "" {
			out = append(out, p)
		}
	}
	return out
}
{{- if eq .notes_source "git" }}

func gitLogNotes(ctx context.Context) (string, error) {
	notes, err := sparkwing.Bash(ctx, `set -euo pipefail
prev=$(git describe --tags --abbrev=0 2>/dev/null || true)
if [ -n "$prev" ]; then
  git log --no-merges --pretty=format:'- %s (%h)' "$prev"..HEAD
else
  git log --no-merges --pretty=format:'- %s (%h)'
fi`).String()
	if err != nil {
		return "", fmt.Errorf("git log notes: %w", err)
	}
	return strings.TrimSpace(notes), nil
}
{{- end }}

func dryRun() bool {
	on, _ := strconv.ParseBool(os.Getenv("SPARKWING_DRY_RUN"))
	return on
}

// Local builds and checks still run in previews; cloud and publish helpers
// honor the host's sealed dry-run environment before any remote mutation.
type {{pascal .pipeline_name}}Action func(context.Context) error

func (a {{pascal .pipeline_name}}Action) Work(w *sparkwing.Work) (*sparkwing.WorkStep, error) {
	return sparkwing.Step(w, "run", func(ctx context.Context) error { return a(ctx) }).
		DryRun(func(ctx context.Context) error { return a(ctx) }), nil
}

func init() {
	sparkwing.Register[sparkwing.NoInputs]({{quote .pipeline_name}}, func() sparkwing.Pipeline[sparkwing.NoInputs] { return &{{pascal .pipeline_name}}{} })
}
